#! /bin/sh

[ "${TRACE}" = 'YES' ] && set -x && : "$0" "$@"

TEST_DIR="`dirname -- "$0"`"
PROJECT_DIR="$( cd "${TEST_DIR}/../.." ; pwd -P)"

MULLE_BASHFUNCTIONS="${PROJECT_DIR}/mulle-bashfunctions"
export MULLE_BASHFUNCTIONS_LIBEXEC_DIR="${MULLE_BASHFUNCTIONS_LIBEXEC_DIR:-${PROJECT_DIR}/src}"


fail()
{
   echo "FAIL: $*" >&2
   exit 1
}


test_good_file()
{
   if ! "${MULLE_BASHFUNCTIONS}" log-checker "${TEST_DIR}/good.sh" 2>/dev/null
   then
      fail "good.sh should pass without errors"
   fi
}


test_bad_file()
{
   if "${MULLE_BASHFUNCTIONS}" log-checker "${TEST_DIR}/bad.sh" 2>/dev/null
   then
      fail "bad.sh should fail"
   fi

   local output

   output="`"${MULLE_BASHFUNCTIONS}" log-checker "${TEST_DIR}/bad.sh" 2>&1`"

   case "${output}" in
      *'use _log_info instead'*)
      ;;
      *)
         fail "expected suggestion to use _log_info, got: ${output}"
      ;;
   esac

   case "${output}" in
      *'use _log_verbose instead'*)
      ;;
      *)
         fail "expected suggestion to use _log_verbose, got: ${output}"
      ;;
   esac

   case "${output}" in
      *'use _log_debug instead'*)
      ;;
      *)
         fail "expected suggestion to use _log_debug, got: ${output}"
      ;;
   esac

   # multiline string literal (unclosed quote)
   case "${output}" in
      *'use _log_warning instead'*)
      ;;
      *)
         fail "expected suggestion to use _log_warning for multiline string, got: ${output}"
      ;;
   esac
}


test_repair()
{
   local tmpfile="${TEST_DIR}/repair-tmp.sh"

   cp "${TEST_DIR}/bad.sh" "${tmpfile}"

   # --repair must not leak anything to stdout (regression: a duplicate
   # "local" declaration made zsh's typeset print "funcname=..." garbage)
   local stdout

   stdout="`"${MULLE_BASHFUNCTIONS}" log-checker --repair "${tmpfile}" 2>/dev/null`"
   if [ -n "${stdout}" ]
   then
      fail "repair must not print to stdout, got: ${stdout}"
   fi

   # at least the first offense must be rewritten to its _log_ variant
   case "`cat "${tmpfile}"`" in
      *_log_info*)
      ;;
      *)
         fail "expected _log_info in repaired file"
      ;;
   esac

   #
   # KNOWN LIMITATION (deferred to next version): repair runs inplace_sed
   # while the file is still being read line-by-line. On darwin the in-place
   # rewrite lengthens a line and desyncs the open read fd, so only the first
   # offense is repaired and later line numbers drift by one. A full re-check
   # of the repaired file is therefore not yet expected to pass clean.
   #

   rm -f "${tmpfile}"
}


test_missing_file()
{
   # should not crash, just warn
   "${MULLE_BASHFUNCTIONS}" log-checker "${TEST_DIR}/nonexistent.sh" 2>/dev/null
   :  # don't fail the test on this
}


main()
{
   test_good_file
   test_bad_file
   test_repair
   test_missing_file

   echo "All tests passed" >&2
}

main "$@"
