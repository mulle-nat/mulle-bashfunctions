#! /bin/sh

[ "${TRACE}" = 'YES' ] && set -x && : "$0" "$@"

TEST_DIR="`dirname -- "$0"`"
PROJECT_DIR="$( cd "${TEST_DIR}/../.." ; pwd -P)"

MULLE_BASHFUNCTIONS="${PROJECT_DIR}/mulle-bashfunctions"
export MULLE_BASHFUNCTIONS_LIBEXEC_DIR="${MULLE_BASHFUNCTIONS_LIBEXEC_DIR:-${PROJECT_DIR}/src}"


fail()
{
   echo "FAIL: $*" >&2
   exit 1
}


test_good_file()
{
   if ! "${MULLE_BASHFUNCTIONS}" local-checker "${TEST_DIR}/good.sh" 2>/dev/null
   then
      fail "good.sh should pass without errors"
   fi
}


test_bad_file()
{
   if "${MULLE_BASHFUNCTIONS}" local-checker "${TEST_DIR}/bad.sh" 2>/dev/null
   then
      fail "bad.sh should fail"
   fi

   local output

   output="`"${MULLE_BASHFUNCTIONS}" local-checker "${TEST_DIR}/bad.sh" 2>&1`"

   # duplicate local foo
   case "${output}" in
      *'redeclared in same function'*)
      ;;
      *)
         fail "expected duplicate redeclaration diagnostic, got: ${output}"
      ;;
   esac

   # local inside a loop
   case "${output}" in
      *'declared inside a loop'*)
      ;;
      *)
         fail "expected loop diagnostic, got: ${output}"
      ;;
   esac
}


test_missing_file()
{
   # should not crash, just warn
   "${MULLE_BASHFUNCTIONS}" local-checker "${TEST_DIR}/nonexistent.sh" 2>/dev/null
   :  # don't fail the test on this
}


main()
{
   test_good_file
   test_bad_file
   test_missing_file

   echo "All tests passed" >&2
}

main "$@"
